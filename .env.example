# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# Neon 연결 문자열 (Neon 콘솔 > Connect). ONEID와 같은 DB를 써도 됩니다 (게임 테이블은 ns_ 접두사).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ONEID 서버 주소 (로컬 개발: http://localhost:8000)
ONEID_URL=http://localhost:8000
ONEID_CLIENT_ID=neonstrip

# ONEID에 등록한 콜백(http://localhost:5504/)과 포트가 같아야 합니다
PORT=5504
